NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas
JWT_SECRET=change-me-to-a-long-random-string-32chars+
RUN_WORKER=true
# HMAC key for opt-out identifiers. Set a long random value in production and never change it.
PII_PEPPER=dev-only-pepper-change-me

# Billing. Without STRIPE_SECRET_KEY (non-production) the "dev" billing provider is used:
# checkout completes instantly and credits are granted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PACK_1=
STRIPE_PRICE_PACK_5=
STRIPE_PRICE_PACK_15=
STRIPE_PRICE_PRO_MONTHLY=
CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancel

# Mail: console logger unless RESEND_API_KEY is set
MAIL_FROM=Support <no-reply@example.com>
RESEND_API_KEY=
APP_URL=http://localhost:5173

# Product
FREE_SEARCHES_PER_DAY=3
SEARCH_PROVIDER=mock
STORAGE_DIR=./storage
MAX_UPLOAD_MB=8
