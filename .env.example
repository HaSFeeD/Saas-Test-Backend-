ENV=development
PORT=8000
LOG_LEVEL=info
PUBLIC_URL=http://localhost:8000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas
JWT_SECRET=change-me-to-a-long-random-string-32chars+
RUN_WORKER=true

# Outbound HTTP (integrations). Optional proxy for all third-party calls.
HTTP_PROXY_URL=
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=4

# Stripe. Without STRIPE_SECRET_KEY the dev billing provider is used:
# checkout completes instantly and credits are granted (no Stripe account needed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PACK_1=
STRIPE_PRICE_PACK_5=
STRIPE_PRICE_PACK_15=
STRIPE_PRICE_PRO_MONTHLY=
CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancel

# Telegram Bot API (optional): notifications + inbound webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Email: logged to console unless RESEND_API_KEY is set.
MAIL_FROM="Support <no-reply@example.com>"
RESEND_API_KEY=

# Outbound webhooks signed with this scheme version (informational).
WEBHOOK_USER_AGENT=saas-backend/1.0

# Product
FREE_SEARCHES_PER_DAY=3
SEARCH_PROVIDER=mock
STORAGE_DIR=./storage
MAX_UPLOAD_MB=8
PII_PEPPER=dev-only-pepper-change-me
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=10
