{
  "name": "saas-backend",
  "version": "0.1.0",
  "description": "SaaS backend: auth, async searches, paywalled reports, credits and Stripe billing",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "make-admin": "tsx --env-file-if-exists=.env src/admin-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": "true",
  "engines": {
    "node": ">=22"
  }
}
